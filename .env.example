# 复制为 .env，填写后重启服务。密钥不会返回到浏览器。
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=

# 企业部署：改为唯一 HTTPS 工作台地址，并设置 Secure Cookie。
ESI_PUBLIC_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ESI_COOKIE_SECURE=0

# 数据文件只能从这些目录接入，多个绝对路径以英文逗号分隔。缺省仅允许 runtime/。
ESI_DATA_ROOTS=/absolute/path/to/approved/business-data

# 只读 HTTPS JSON 数据接口。先列出允许的主机名，再由密钥管理系统注入所需令牌。
ESI_CONNECTOR_HOSTS=api.example.internal
# ESI_CONNECTOR_TOKEN_ORDERS=由密钥管理系统注入

# 团队默认 Docker；local 仅限可信单机开发，生产启动脚本不接受 local。
ESI_EXECUTION_MODE=docker
ESI_EXECUTION_IMAGE=python:3.12-slim
